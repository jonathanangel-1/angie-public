# Copy to .env.local (gitignored). The default path needs NO paid API key.

# Your private access code (signs in as user "angie"). Pick a long random string.
ANGIE_ACCESS_CODE=
# More people later: "userId:code,otherUser:otherCode"
EXTRA_ACCESS_CODES=

# The open-model garment service (spike/server.py). Required outside demo mode.
GARMENT_SERVICE_URL=http://127.0.0.1:8765

# Optional, paid: SerpApi (Google Lens + Google Shopping) for stores not on Shopify.
# Plans: free 250 searches/month; Starter $25/1k; Developer $75/5k. About 4 searches per look.
SERPAPI_API_KEY=

# Set by `npm run demo` (1) and `npm run dev` (0). Demo mode = fictional data only.
PUBLIC_DEMO=

# Tests only.
ANGIE_STATE_DIR=
SHOPIFY_CATALOG_URL=
