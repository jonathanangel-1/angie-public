# Copy to .env.local (gitignored) for private use. No paid API keys are needed.

# Your private access code. Pick a long random string. Signs in as user "angie".
ANGIE_ACCESS_CODE=

# More people later, without code changes: "userId:code,otherUser:otherCode"
EXTRA_ACCESS_CODES=

# Used by `npm run catalog:import` to reach your running server.
ANGIE_URL=http://127.0.0.1:3000
ANGIE_IMPORT_CODE=

# Set by `npm run demo` (1) and `npm run dev` (0). Demo mode enables the
# fictional profile and the public code "demo-participant"; never enable it with real data.
PUBLIC_DEMO=

# Tests only: a throwaway directory for local database state.
ANGIE_STATE_DIR=
